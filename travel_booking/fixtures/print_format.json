  "html": "<div style=\"font-family:'DM Sans',Arial,sans-serif;max-width:420px;margin:0 auto;padding:32px 28px;color:#1E1C18\">\r\n\r\n  <div style=\"display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px\">\r\n    <div>\r\n      <div style=\"font-size:20px;font-weight:700;letter-spacing:-0.02em\">Rare<span style=\"font-weight:300\">cruise</span></div>\r\n      <div style=\"font-size:10px;color:#B0AC9F;margin-top:2px\">by Rarecation</div>\r\n    </div>\r\n    <div style=\"text-align:right\">\r\n      <div style=\"font-size:13px;font-weight:600\">Invoice</div>\r\n      <div style=\"font-size:11px;color:#7D7A70;font-family:monospace\">{{ doc.name }}</div>\r\n    </div>\r\n  </div>\r\n\r\n  <div style=\"display:flex;justify-content:space-between;font-size:11px;margin-bottom:16px;border-top:0.5px solid #EAE7E0;border-bottom:0.5px solid #EAE7E0;padding:12px 0\">\r\n    <div>\r\n      <div style=\"color:#7D7A70;margin-bottom:2px\">Billed to</div>\r\n      <div>{{ doc.customer_name or doc.customer }}</div>\r\n    </div>\r\n    <div style=\"text-align:right\">\r\n      <div style=\"color:#7D7A70;margin-bottom:2px\">Invoice date</div>\r\n      <div>{{ frappe.utils.formatdate(doc.posting_date) }}</div>\r\n    </div>\r\n  </div>\r\n\r\n  <div style=\"margin-bottom:8px\">\r\n    <div style=\"display:flex;font-size:10px;color:#7D7A70;padding-bottom:6px;border-bottom:0.5px solid #EAE7E0\">\r\n      <span style=\"flex:1\">Item</span><span style=\"width:50px;text-align:right\">Qty</span><span style=\"width:80px;text-align:right\">Amount</span>\r\n    </div>\r\n    {% for item in doc.items %}\r\n    <div style=\"display:flex;font-size:11px;padding:8px 0;border-bottom:0.5px solid #EAE7E0;{% if item.amount < 0 %}color:#0F6E56{% endif %}\">\r\n      <span style=\"flex:1\">{{ item.item_name }}</span>\r\n      <span style=\"width:50px;text-align:right\">{{ item.qty|int if item.qty != 1 else \"\" }}</span>\r\n      <span style=\"width:80px;text-align:right\">{{ \"{:,.2f}\".format(item.amount or 0) }}</span>\r\n    </div>\r\n    {% endfor %}\r\n  </div>\r\n\r\n  <div style=\"display:flex;justify-content:space-between;align-items:baseline;margin:16px 0 24px\">\r\n    <span style=\"font-size:13px;font-weight:600\">Total</span>\r\n    <span style=\"font-size:20px;font-weight:700;color:#D4A312\">RM {{ \"{:,.2f}\".format(doc.grand_total or 0) }}</span>\r\n  </div>\r\n\r\n  <div style=\"text-align:center;font-size:9px;color:#B0AC9F;line-height:1.6\">\r\n    This is a computer-generated invoice.<br>Rarecation Sdn Bhd &middot; contact@rarecruise.com\r\n  </div>\r\n\r\n</div>",
