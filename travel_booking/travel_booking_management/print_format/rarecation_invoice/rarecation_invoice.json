 "html": "<div style=\"font-family:'DM Sans',Arial,sans-serif;max-width:420px;margin:0 auto;padding:32px 28px;color:#1A2340\">\r\n  <div style=\"display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px\">\r\n    <div>\r\n      <div style=\"font-size:20px;font-weight:700;letter-spacing:-0.02em\">Rare<span style=\"font-weight:300\">cruise</span></div>\r\n      <div style=\"font-size:10px;color:#AAAAAA;margin-top:2px\">by Rarecation</div>\r\n    </div>\r\n    <div style=\"text-align:right\">\r\n      <div style=\"font-size:13px;font-weight:600\">Invoice</div>\r\n      <div style=\"font-size:11px;color:#666666;font-family:monospace\">{{ doc.name }}</div>\r\n    </div>\r\n  </div>\r\n\r\n  <div style=\"display:flex;justify-content:space-between;font-size:11px;margin-bottom:16px;border-top:0.5px solid #EEEEEE;border-bottom:0.5px solid #EEEEEE;padding:12px 0\">\r\n    <div>\r\n      <div style=\"color:#666666;margin-bottom:2px\">Billed to</div>\r\n      <div>{{ doc.customer_name or doc.customer }}</div>\r\n    </div>\r\n    <div style=\"text-align:right\">\r\n      <div style=\"color:#666666;margin-bottom:2px\">Invoice date</div>\r\n      <div>{{ frappe.utils.formatdate(doc.posting_date) }}</div>\r\n    </div>\r\n  </div>\r\n\r\n  {% set booking_ref = frappe.db.get_value(\"Booking\", doc.custom_booking, \"booking_number\") if doc.get(\"custom_booking\") else None %}\r\n  {% if booking_ref %}\r\n  <div style=\"display:flex;justify-content:space-between;font-size:11px;margin-bottom:16px\">\r\n    <span style=\"color:#666666\">Booking ref</span>\r\n    <span style=\"font-family:monospace;font-weight:600\">{{ booking_ref }}</span>\r\n  </div>\r\n  {% endif %}\r\n\r\n  <div style=\"margin-bottom:8px\">\r\n    <div style=\"display:flex;font-size:10px;color:#666666;padding-bottom:6px;border-bottom:0.5px solid #EEEEEE\">\r\n      <span style=\"flex:1\">Item</span><span style=\"width:50px;text-align:right\">Qty</span><span style=\"width:80px;text-align:right\">Amount</span>\r\n    </div>\r\n    {% for item in doc.items %}\r\n    {% set desc_parts = (item.description or \"\").split(\" | \") %}\r\n    <div style=\"display:flex;font-size:11px;padding:8px 0;border-bottom:0.5px solid #EEEEEE;page-break-inside:avoid;{% if item.amount < 0 %}color:#1A7A4A{% endif %}\">\r\n      <span style=\"flex:1\">\r\n        {{ item.item_name }}\r\n        {% if desc_parts|length >= 5 %}\r\n        <div style=\"font-size:9px;color:#AAAAAA;margin-top:1px\">{{ desc_parts[2] }} &middot; {{ desc_parts[3] }} &middot; {{ desc_parts[4] }}</div>\r\n        {% endif %}\r\n      </span>\r\n      <span style=\"width:50px;text-align:right\">{{ item.qty|int if item.qty and item.qty != 1 else \"\" }}</span>\r\n      <span style=\"width:80px;text-align:right\">{{ \"{:,.2f}\".format(item.amount or 0) }}</span>\r\n    </div>\r\n    {% endfor %}\r\n  </div>\r\n\r\n  <div style=\"display:flex;justify-content:space-between;align-items:baseline;margin:16px 0 24px\">\r\n    <span style=\"font-size:13px;font-weight:600\">Total</span>\r\n    <span style=\"font-size:20px;font-weight:700;color:#C9A84C\">RM {{ \"{:,.2f}\".format(doc.grand_total or 0) }}</span>\r\n  </div>\r\n\r\n  <div style=\"text-align:center;font-size:9px;color:#AAAAAA;line-height:1.6\">\r\n    This is a computer-generated invoice.<br>\r\n    Rarecation Sdn Bhd &middot; contact@rarecation.com\r\n  </div>\r\n</div>",
