 "html": "<div style=\"font-family:'DM Sans',Arial,sans-serif;max-width:380px;margin:0 auto;padding:32px 28px;color:#1A2340\">\r\n  <div style=\"text-align:center;margin-bottom:24px\">\r\n    <div style=\"font-size:20px;font-weight:700;letter-spacing:-0.02em\">Rare<span style=\"font-weight:300\">cruise</span></div>\r\n    <div style=\"font-size:10px;color:#AAAAAA;margin-top:2px\">by Rarecation</div>\r\n  </div>\r\n\r\n  <div style=\"text-align:center;margin-bottom:20px\">\r\n    <div style=\"font-size:13px;font-weight:600\">Payment receipt</div>\r\n    <div style=\"font-size:11px;color:#666666;font-family:monospace\">{{ doc.name }}</div>\r\n  </div>\r\n\r\n  <div style=\"border-top:0.5px solid #EEEEEE;border-bottom:0.5px solid #EEEEEE;padding:12px 0;margin-bottom:16px\">\r\n    <div style=\"display:flex;justify-content:space-between;font-size:11px;padding:3px 0\">\r\n      <span style=\"color:#666666\">Date</span><span>{{ frappe.utils.formatdate(doc.posting_date) }}</span>\r\n    </div>\r\n    <div style=\"display:flex;justify-content:space-between;font-size:11px;padding:3px 0\">\r\n      <span style=\"color:#666666\">Received from</span><span>{{ doc.party_name or doc.party }}</span>\r\n    </div>\r\n    {% if doc.references and doc.references|length > 0 %}\r\n    <div style=\"display:flex;justify-content:space-between;font-size:11px;padding:3px 0\">\r\n      <span style=\"color:#666666\">Sales order</span><span style=\"font-family:monospace\">{{ doc.references[0].reference_name }}</span>\r\n    </div>\r\n    {% endif %}\r\n    {% if doc.mode_of_payment %}\r\n    <div style=\"display:flex;justify-content:space-between;font-size:11px;padding:3px 0\">\r\n      <span style=\"color:#666666\">Mode of payment</span><span>{{ doc.mode_of_payment }}</span>\r\n    </div>\r\n    {% endif %}\r\n    {% if doc.reference_no %}\r\n    <div style=\"display:flex;justify-content:space-between;font-size:11px;padding:3px 0\">\r\n      <span style=\"color:#666666\">Reference no</span><span style=\"font-family:monospace\">{{ doc.reference_no }}</span>\r\n    </div>\r\n    {% endif %}\r\n  </div>\r\n\r\n  <div style=\"display:flex;justify-content:space-between;align-items:baseline;margin-bottom:24px\">\r\n    <span style=\"font-size:13px;font-weight:600\">Amount received</span>\r\n    <span style=\"font-size:20px;font-weight:700;color:#1A7A4A\">RM {{ \"{:,.2f}\".format(doc.paid_amount or 0) }}</span>\r\n  </div>\r\n\r\n  <div style=\"text-align:center;font-size:9px;color:#AAAAAA;line-height:1.6\">\r\n    This is a computer-generated receipt.<br>\r\n    Rarecation Sdn Bhd &middot; contact@rarecation.com\r\n  </div>\r\n</div>",
